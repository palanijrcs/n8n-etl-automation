    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\nRules:\nName: Title Case (Manoj K)\nEmail: if invalid set INVALID_EMAIL\nPhone: if less than 10 digits set MISSING\nCourse: only Python or Machine Learning or Data Science\nFee_Paid: yes/YES = true, no/NO = false\nCity: Title Case, empty = UNKNOWN\nEnrolled_Date: convert to YYYY-MM-DD\nReturn ONLY raw JSON. No explanation. No markdown.\n\n",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -848,
        0
      ],
      "id": "3eb7fd7f-1cd6-42a0-baf0-36aea80b4b57",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -592,
        208
      ],
      "id": "d6a07fed-96cb-48de-8ed0-4bb1bd86c96a",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "CTEZU19ZZn6wpfFe",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get all incoming items\nconst items = $input.all();\n\n// Process every item\nreturn items.map((item) => {\n\n  // Get the AI-generated text\n  let rawText = item.json.text;\n\n  // Remove Markdown code fences if the AI added them\n  rawText = rawText\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  let data;\n\n  try {\n    // Parse the JSON string\n    data = JSON.parse(rawText);\n  } catch (error) {\n    // Return the original data with an error message\n    return {\n      json: {\n        ...item.json,\n        parse_status: \"ERROR\",\n        parse_error: error.message\n      }\n    };\n  }\n\n  // Clean and standardize the data\n  return {\n    json: {\n      Student_ID: String(data.Student_ID || \"\").trim(),\n      Name: String(data.Name || \"\").trim(),\n      Email: String(data.Email || \"\").trim().toLowerCase(),\n      Phone: String(data.Phone || \"\").trim(),\n      Course: String(data.Course || \"\").trim(),\n      Fee_Paid: Boolean(data.Fee_Paid),\n      City: String(data.City || \"\").trim(),\n      Enrolled_Date: String(data.Enrolled_Date || \"\").trim(),\n\n      // Check whether email is valid\n      Email_Status: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.Email || \"\")\n        ? \"Valid\"\n        : \"Invalid\",\n\n      parse_status: \"OK\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
